# --- LLM ---
# Clave directa de Anthropic (la via mas simple para correr local).
ANTHROPIC_API_KEY=
# Modelo a usar (se puede sobreescribir).
AI_MODEL=claude-sonnet-5

# --- Proveedor de mensajeria ---
# Valores: cli | meta
MESSAGING_PROVIDER=cli

# --- Meta WhatsApp Cloud API (solo si MESSAGING_PROVIDER=meta) ---
# Token de acceso permanente de la app de Meta.
META_ACCESS_TOKEN=
# ID del numero de telefono de WhatsApp Business.
META_PHONE_NUMBER_ID=
# Token que vos elegis para verificar el webhook con Meta.
META_VERIFY_TOKEN=
# App secret de la app de Meta (opcional pero recomendado: verifica la firma del webhook).
META_APP_SECRET=
# Opcional. Overrides de destinatario "waId=aQuienEnviar", separados por coma.
# Escape hatch para el NÚMERO DE PRUEBA de Meta cuando su lista de autorizados
# guarda el número en otro formato que el wa_id del webhook (caso típico Argentina:
# llega con "9" pero el sandbox lo tiene con "15"). Ej para varios:
#   META_RECIPIENT_OVERRIDES=5491151769708=54111551769708,5493511234567=543511512345
# Vacío en producción (ahí se responde directo al wa_id).
META_RECIPIENT_OVERRIDES=

# --- Persistencia de leads/eventos ---
# Valores: jsonl (default, archivos locales) | postgres
PERSISTENCE=jsonl
# Solo si PERSISTENCE=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lacaja

# --- Almacenamiento de sesiones ---
# Valores: memory (default) | redis
SESSION_STORE=memory
# Solo si SESSION_STORE=redis
REDIS_URL=redis://localhost:6379
# TTL de una sesion inactiva en Redis (segundos). Default 24h.
SESSION_TTL_SECONDS=86400

# --- Server ---
PORT=3000
