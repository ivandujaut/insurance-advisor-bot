{
  "name": "lacaja-whatsapp-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de WhatsApp para cotizacion y consulta de polizas de seguros (La Caja). Motor hibrido: menus + LLM.",
  "type": "module",
  "scripts": {
    "chat": "tsx src/main/chat.ts",
    "funnel": "tsx src/main/funnel.ts",
    "dev": "tsx watch src/main/server.ts",
    "start": "node dist/main/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf .test-tmp && LACAJA_DATA_DIR=.test-tmp ANTHROPIC_API_KEY= tsx --test src/domain/conversation/*.test.ts src/application/*.test.ts src/infrastructure/persistence/*.test.ts",
    "check:arch": "node scripts/check-arch.mjs",
    "format": "biome format --write src scripts",
    "lint": "biome check src scripts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mjs}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@hono/node-server": "^1.13.0",
    "ai": "^4.0.0",
    "hono": "^4.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@commitlint/cli": "^19.8.1",
    "@types/node": "^20.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
