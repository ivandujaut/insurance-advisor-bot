{
  "name": "lacaja-whatsapp-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de WhatsApp para cotizacion y consulta de polizas de seguros (La Caja). Motor hibrido: menus + LLM.",
  "type": "module",
  "scripts": {
    "chat": "tsx src/scripts/chat.ts",
    "funnel": "tsx src/scripts/funnel.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf .test-tmp && LACAJA_DATA_DIR=.test-tmp ANTHROPIC_API_KEY= tsx --test src/lib/conversation/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@hono/node-server": "^1.13.0",
    "ai": "^4.0.0",
    "hono": "^4.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
